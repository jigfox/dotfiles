{{- $w := include "secrets/work.yaml.age" | decrypt | fromYaml -}}
{
  "extends": [
    "{{ index $w.nono.profiles "work-claude-core" }}",
    "codex",
    "base"
  ],
  "meta": {
    "name": "{{ $w.nono.profiles.work }}",
    "version": "1.0.0",
    "description": "Work sandbox for claude and codex",
    "author": null
  },
  "security": {
    "signal_mode": null,
    "process_info_mode": null,
    "ipc_mode": null,
    "capability_elevation": null,
    "approval_backends": {},
    "approval_defaults": null,
    "wsl2_proxy_policy": null
  },
  "groups": {
    "include": [],
    "exclude": []
  },
  "commands": {
    "allow": [],
    "deny": []
  },
  "filesystem": {
    "allow": [
      "~/src/{{ $w.gitlab_host }}/.codex"
    ],
    "read": [
      "~/.ssh/{{ $w.ssh_key }}",
      "~/.ssh/{{ $w.ssh_key }}.pub",
      "~/.aws/sso/cache",
      "~/.aws/cli/cache",
      "~/src/{{ $w.gitlab_host }}"
    ],
    "write": [],
    "allow_file": [
      "~/src/{{ $w.gitlab_host }}/.claude/settings.json"
    ],
    "read_file": [
      "~/src/{{ $w.gitlab_host }}/.claude/.claude.json",
      "~/src/{{ $w.gitlab_host }}/.claude/cache/changelog.md",
      "~/src/{{ $w.gitlab_host }}/.claude/history.jsonl",
      "~/.claude/plugins/marketplaces/always-further/plugins/nono",
      "~/.claude/plugins/marketplaces/always-further/.claude-plugin/marketplace.json",
      "~/Library/Keychains/login.keychain-db",
      "/private/etc/resolv.conf",
      "/private/etc/hosts",
      "/private/etc/ssl/cert.pem",
      "/private/etc/ssl/certs"
    ],
    "write_file": [],
    "unix_socket": [],
    "unix_socket_bind": [],
    "unix_socket_dir": [],
    "unix_socket_dir_bind": [],
    "unix_socket_subtree": [],
    "unix_socket_subtree_bind": [],
    "deny": [
      "~/.claude",
      "~/.claude.json",
      "~/.claude.json.lock",
      "~/.claude.lock",
      "~/src/{{ $w.gitlab_host }}/mise.toml",
      "~/src/{{ $w.gitlab_host }}/kubeconfig",
      "~/src/{{ $w.gitlab_host }}/mise.local.toml",
      "~/src/{{ $w.gitlab_host }}/.mise.toml",
      "~/src/{{ $w.gitlab_host }}/.mise.local.toml",
      "~/src/{{ $w.gitlab_host }}/mise",
      "~/src/{{ $w.gitlab_host }}/.mise",
      "~/src/{{ $w.gitlab_host }}/.config/mise",
      "~/src/{{ $w.gitlab_host }}/.config/mise.toml"
    ],
    "bypass_protection": [
      "~/.ssh/{{ $w.ssh_key }}",
      "~/.ssh/{{ $w.ssh_key }}.pub",
      "~/Library/Keychains/login.keychain-db"
    ],
    "suppress_save_prompt": [
      "/Users",
      "~/",
      "/",
      "/arm64"
    ]
  },
  "network": {
    "block": false,
    "allow_http2": false,
    "allow_domain": [],
    "deny_domain": [],
    "credentials": [
      "gitlab"
    ],
    "open_port": [
      0
    ],
    "open_port_range": [],
    "listen_port": [],
    "listen_port_range": [
      [
        49152,
        65535
      ]
    ],
    "connect_port": [],
    "no_proxy": [],
    "custom_credentials": {
      "gitlab": {
        "upstream": "https://{{ $w.gitlab_host }}",
        "credential_key": "apple-password://{{ $w.gitlab_host }}/fahnenbruck-token",
        "redeem_phantoms": [],
        "auth": null,
        "inject_mode": "header",
        "inject_header": "PRIVATE-TOKEN",
        "credential_format": null,
        "path_pattern": null,
        "path_replacement": null,
        "query_param_name": null,
        "proxy": null,
        "env_var": "GITLAB_TOKEN",
        "endpoint_rules": [],
        "endpoint_policy": null,
        "tls_ca": null,
        "tls_client_cert": null,
        "tls_client_key": null,
        "aws_auth": null,
        "spiffe": null,
        "rate_limit": null
      }
    },
    "tls_intercept": null,
    "upstream_proxy": null,
    "upstream_bypass": []
  },
  "diagnostics": {
    "suppress_system_services": [],
    "redaction": {
      "extra_env_vars": []
    },
    "network_denial_audit": {}
  },
  "linux": {
    "af_unix_mediation": null,
    "sandbox_policy": null
  },
  "env_credentials": {},
  "credential_capture": {},
  "credential_providers": {},
  "credential_routes": [],
  "workdir": {
    "access": "none"
  },
  "hooks": {},
  "session_hooks": {},
  "rollback": {
    "exclude_patterns": [],
    "exclude_globs": []
  },
  "open_urls": {
    "allow_origins": [
      "https://auth.atlassian.com",
      "https://{{ $w.hosts.backstage }}",
      "https://claude.ai",
      "https://{{ $w.gitlab_host }}",
      "https://mcp.miro.com",
      "https://{{ $w.hosts.monitoring_mcp }}"
    ],
    "allow_localhost": false
  },
  "skipdirs": [],
  "packs": [],
  "command_args": [],
  "unsafe_macos_seatbelt_rules": []
}
