theme = Duskfox

font-family = Comic Code Ligatures
font-family-bold = Comic Code Ligatures Bold
font-family-italic = Comic Code Ligatures Italic
font-family-bold-italic = Comic Code Ligatures Bold Italic

# window-decoration = none
macos-titlebar-proxy-icon = hidden
macos-titlebar-style = hidden
window-padding-x = 7
window-padding-y = 7

# match kitty: smaller font, crisper text blending
font-size = 11
alpha-blending = native
font-thicken = true
font-thicken-strength = 64
adjust-cell-height = 20%
adjust-cell-width = 3%
