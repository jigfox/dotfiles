{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# defaults hash: {{ .macos.defaults | toJson | sha256sum }}
{{ range .macos.defaults -}}
defaults write {{ .domain }} {{ .key }} -{{ .type }} {{ .value }}
{{ end -}}
{{ range (.macos.defaults | jq "[.[].restart | select(.)] | unique | .[]") -}}
killall {{ . }} || true
{{ end -}}
{{ end -}}
