{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
{{ template "brew-shellenv.sh" }}
fish_path="$HOMEBREW_PREFIX/bin/fish"
# Runs on every apply (it is a no-op once set), so a missing fish is retried
if [ ! -x "$fish_path" ]; then
    echo "$fish_path not found, login shell not changed." >&2
    exit 0
fi

if ! grep -qxF "$fish_path" /etc/shells; then
    echo "Adding $fish_path to /etc/shells..."
    echo "$fish_path" | sudo tee -a /etc/shells > /dev/null
fi
if [ "$(dscl . -read "$HOME" UserShell | awk '{print $2}')" != "$fish_path" ]; then
    chsh -s "$fish_path"
fi
{{ end -}}
