#!/bin/bash
# fish_plugins hash: {{ include "dot_config/fish/fish_plugins" | sha256sum }}
{{ template "brew-shellenv.sh" }}
if command -v fish &> /dev/null; then
    echo "Syncing fish plugins..."
    fish -c 'type -q fisher; or curl -fsSL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source; and fisher update'
fi
