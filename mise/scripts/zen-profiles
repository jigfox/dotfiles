#!/bin/bash
# post-dotfiles hook: register the Zen profiles whose files mise deploys
# (Profiles/<name>, fixed folder names) in profiles.ini and make the first one
# the default profile of this Zen install.
#
#   zen-profiles <environment>...     the selected config environments
#
# environment -> profile: inovex -> inovex, customer-a -> customer,
# personal -> private. Default profile: inovex, then customer, then private.
set -euo pipefail
. "$(dirname "$0")/lib.sh"

is_macos || exit 0
PROFILES=()
for pair in inovex:inovex customer-a:customer personal:private; do
    for env in "$@"; do
        [ "$env" = "${pair%%:*}" ] && PROFILES+=("${pair##*:}")
    done
done
[ ${#PROFILES[@]} -gt 0 ] || exit 0

ZEN="${ZEN_APP:-/Applications/Zen.app}/Contents/MacOS/zen"
ZEN_DIR="$HOME/Library/Application Support/zen"
INI="$ZEN_DIR/profiles.ini"

[ -x "$ZEN" ] || exit 0

missing=()
for name in "${PROFILES[@]}"; do
    grep -qx "Name=$name" "$INI" 2>/dev/null || missing+=("$name")
done
[ ${#missing[@]} -gt 0 ] || exit 0

if pgrep -xq zen; then
    echo "Zen is running, can't create profiles ${missing[*]} (quit Zen and run bootstrap again)" >&2
    exit 1
fi

for name in "${missing[@]}"; do
    "$ZEN" --headless -CreateProfile "$name $ZEN_DIR/Profiles/$name"
    echo "created Zen profile $name"
done

# The install's default lives in an [Install<hash of the app path>] section, which Zen only
# writes on its first start, creating and selecting a new "Default (release)" profile.
# Let that happen, then remove that (empty) profile again.
if ! grep -q '^\[Install' "$INI"; then
    tmp=$(mktemp -d)
    "$ZEN" --headless --screenshot "$tmp/zen.png" about:blank >/dev/null 2>&1 || true
    rm -rf "$tmp"
    created=$(sed -n '/^\[Install/,/^$/ s/^Default=//p' "$INI" | head -n1)
    case $created in
        Profiles/*.Default\ \(release\))
            awk -v path="Path=$created" '
                BEGIN { RS = ""; ORS = "\n\n" }
                index($0, path) == 0' "$INI" >"$INI.tmp" && mv "$INI.tmp" "$INI"
            rm -rf "${ZEN_DIR:?}/$created"
            echo "removed Zen's auto-created profile $created"
            ;;
    esac
fi

# a no-op when the default is already right
sed -i '' "/^\[Install/,/^$/ s|^Default=.*|Default=Profiles/${PROFILES[0]}|" "$INI"
# installs.ini has only install sections
[ ! -f "$ZEN_DIR/installs.ini" ] || sed -i '' "s|^Default=.*|Default=Profiles/${PROFILES[0]}|" "$ZEN_DIR/installs.ini"
