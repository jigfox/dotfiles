#!/bin/bash
# Download the files listed in externals.toml (the counterpart of
# .chezmoiexternal.toml): url, sha256, optional executable and os. A file whose
# hash already matches is left alone, a download that does not match is dropped.
set -euo pipefail
. "$(dirname "$0")/lib.sh"

for tool in yq jq curl; do
    command -v "$tool" >/dev/null || { echo "$tool is required" >&2; exit 1; }
done

yq -p toml -o json '.' "$repo_root/externals.toml" |
    jq -r 'to_entries[] | [.key, .value.url, .value.sha256, (.value.executable // false | tostring), (.value.os // "")] | @tsv' |
    while IFS=$'\t' read -r dest url sha executable os; do
        case "$os" in
            macos) is_macos || continue ;;
            "") ;;
            *) echo "unknown os $os for $dest" >&2; exit 1 ;;
        esac
        dest="${dest/#\~/$HOME}"
        if [ -f "$dest" ] && [ "$(shasum -a 256 <"$dest" | cut -d' ' -f1)" = "$sha" ]; then
            if [ "$executable" = true ]; then chmod 755 "$dest"; else chmod 644 "$dest"; fi
            continue
        fi
        echo "fetching $dest"
        mkdir -p "$(dirname "$dest")"
        tmp="$(mktemp "$dest.XXXXXX")"
        curl -fsSL "$url" -o "$tmp"
        if [ "$(shasum -a 256 <"$tmp" | cut -d' ' -f1)" != "$sha" ]; then
            rm -f "$tmp"
            echo "checksum mismatch for $url" >&2
            exit 1
        fi
        if [ "$executable" = true ]; then chmod 755 "$tmp"; else chmod 644 "$tmp"; fi
        mv "$tmp" "$dest"
    done
