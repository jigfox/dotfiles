#!/bin/bash
# post-dotfiles hook of the customer-a environment. The customer's file names
# are not public, so they come from fnox secrets (the hook runs under
# `fnox exec`) and are only ever created here:
#  - the ssh bundle (key pair, names inside the tarball) is an age blob,
#    unpacked again when the blob changes or a file is missing
#  - the work nono profiles and the work mise.toml are deployed under neutral
#    names and linked where the customer-specific names are expected;
#    runs on every bootstrap so lost links return
set -euo pipefail
. "$(dirname "$0")/lib.sh"

for var in CUSTOMER_A_GITLAB_HOST CUSTOMER_A_NONO_PROFILE_WORK CUSTOMER_A_NONO_PROFILE_CORE CUSTOMER_A_SSH_KEY; do
    if [ -z "${!var:-}" ]; then
        echo "$var is not set, run bootstrap under fnox exec (mise run apply)" >&2
        exit 1
    fi
done

bundle="$repo_root/secrets/customer-a/work-ssh.tar.gz.age"
hash="$(sha256_stdin <"$bundle")"
if [ ! -f "$HOME/.ssh/$CUSTOMER_A_SSH_KEY" ] || ! unchanged customer-a-ssh "$hash"; then
    mkdir -p "$HOME/.ssh"
    chmod 700 "$HOME/.ssh"
    age --decrypt -i "$age_key" "$bundle" | tar -xzf - -C "$HOME"
    record customer-a-ssh "$hash"
    echo "unpacked the customer-a ssh bundle"
fi

profiles="$HOME/.config/nono/profiles"
mkdir -p "$profiles"
ln -sfn "../work/work.json" "$profiles/$CUSTOMER_A_NONO_PROFILE_WORK.json"
ln -sfn "../work/work-claude-core.json" "$profiles/$CUSTOMER_A_NONO_PROFILE_CORE.json"

# mise takes config_root from the link's location, not the target's
mkdir -p "$HOME/src/$CUSTOMER_A_GITLAB_HOST"
ln -sfn "$HOME/.config/work/mise.toml" "$HOME/src/$CUSTOMER_A_GITLAB_HOST/mise.toml"
