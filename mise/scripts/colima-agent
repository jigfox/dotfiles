#!/usr/bin/env bash
# Reference-counted Colima VM for sandboxed agents, one per mise config root.
# mise's enter/leave hooks register the calling fish shell's PID. One watcher
# per root starts the VM, prunes PIDs of shells that are gone (leave never
# fires when a terminal is closed) and stops the VM once none are left.
set -euo pipefail

usage() {
  echo "usage: ${0##*/} enter|leave <config-root> <shell-pid> | watch|status <config-root>" >&2
  exit 2
}

[ $# -ge 2 ] || usage
CMD=$1
ROOT=$(cd "$2" && pwd -P)

# Colima profile names allow letters, digits and dashes only
name=$(basename "$ROOT" | tr -c 'A-Za-z0-9-\n' '-')
PROFILE="agent-$name"
STATE="$HOME/.local/state/colima-agent/$name"
PIDS="$STATE/pids"
LOCK="$STATE/watcher.lock"
LOG="$STATE/watcher.log"
INTERVAL=15
GRACE=2 # empty checks in a row before stopping, so a quick cd out and back keeps the VM

# Colima falls back to ~/.colima when XDG_CONFIG_HOME is unset, which the hook
# environment does not guarantee; that silently creates a second, empty VM.
export COLIMA_HOME="$HOME/.config/colima"

# The hooks can fire inside nono too, where Colima is out of reach.
[ -z "${NONO_CAP_FILE:-}" ] || exit 0

mkdir -p "$PIDS"

live_shells() {
  local f pid n=0
  for f in "$PIDS"/*; do
    [ -e "$f" ] || continue
    pid=${f##*/}
    # the comm check keeps a recycled PID from holding the VM up
    if ps -p "$pid" -o comm= 2>/dev/null | grep -q fish; then
      n=$((n + 1))
    else
      rm -f "$f"
    fi
  done
  echo "$n"
}

# The lock holds the watcher's PID. A watcher killed by SIGKILL never runs its
# trap, so a lock whose PID is gone (or no longer a watcher) is taken over.
lock_is_stale() {
  local pid
  pid=$(cat "$LOCK/pid" 2>/dev/null) || pid=
  if [ -n "$pid" ]; then
    ! ps -p "$pid" -o args= 2>/dev/null | grep -q "${0##*/} watch"
  else
    # no PID yet: a watcher may be spawning right now, so only an old lock is stale
    [ -n "$(find "$LOCK" -maxdepth 0 -mmin +1)" ]
  fi
}

release_lock() {
  [ "$(cat "$LOCK/pid" 2>/dev/null)" = "$$" ] || return 0
  rm -f "$LOCK/pid"
  rmdir "$LOCK"
}

ensure_watcher() {
  if ! mkdir "$LOCK" 2>/dev/null; then
    lock_is_stale || return 0
    echo "$(date '+%F %T') taking over stale lock (pid $(cat "$LOCK/pid" 2>/dev/null || echo none))" >>"$LOG"
    rm -f "$LOCK/pid"
    rmdir "$LOCK" 2>/dev/null || true
    mkdir "$LOCK" 2>/dev/null || return 0
  fi
  nohup "$0" watch "$ROOT" >>"$LOG" 2>&1 </dev/null &
  echo $! >"$LOCK/pid"
}

watch() {
  # nohup execs, so this is the same PID ensure_watcher records
  echo $$ >"$LOCK/pid"
  trap release_lock EXIT
  trap 'exit 1' TERM INT HUP
  echo "$(date '+%F %T') watcher $$ started"
  colima status "$PROFILE" >/dev/null 2>&1 ||
    colima start "$PROFILE" --mount "$ROOT:w" --cpu 4 --memory 8
  local empty=0
  while [ "$empty" -lt "$GRACE" ]; do
    sleep "$INTERVAL"
    if [ "$(live_shells)" -gt 0 ]; then empty=0; else empty=$((empty + 1)); fi
  done
  colima stop "$PROFILE"
  release_lock
  # a shell may have registered while we were stopping and seen our lock
  [ "$(live_shells)" -eq 0 ] || ensure_watcher
}

case "$CMD" in
enter) : >"$PIDS/${3:?shell pid}" && ensure_watcher ;;
leave) rm -f "$PIDS/${3:?shell pid}" ;;
watch) watch ;;
status) echo "$PROFILE shells: $(live_shells)" && colima status "$PROFILE" ;;
*) usage ;;
esac
