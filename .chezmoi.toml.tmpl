{{- /* work and personal are independent: a machine can be both */ -}}
{{- $work := promptBoolOnce . "work" "Use this machine for work" -}}
{{- $personal := promptBoolOnce . "personal" "Use this machine for personal stuff" -}}
encryption = "age"
[age]
  identities = ["~/.config/age/keys.txt"]
  recipients = ["age19yca22n4t2yfxf9t7eduls2w2rrz4y2w76yrrt2cwgszf2r4ly8sm8rksk"]

[diff]
  pager = "delta"

# Local nono profile edits are bundled into the source before they could be overwritten
[hooks.apply.pre]
  command = "{{ .chezmoi.sourceDir }}/scripts/nono-sync.sh"
  args = ["save"]
[hooks.update.pre]
  command = "{{ .chezmoi.sourceDir }}/scripts/nono-sync.sh"
  args = ["save"]

[data]
  work = {{ $work }}
  personal = {{ $personal }}
